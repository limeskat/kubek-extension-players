{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "backend/**/*",
    "frontend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend/dist",
    "frontend/index.ts",
    "backend/**/*.test.ts",
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "backend/entry.js"
  ]
}