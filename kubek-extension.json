{
  "manifestVersion": 1,
  "id": "io.github.limeskat.players",
  "name": "Players Management",
  "version": "1.6.0",
  "description": "Player management for Kubek with a native panel UI: access tabs, live vitals, inventory inspector, teleport, statistics and data purge.",
  "author": {
    "name": "limeskat",
    "url": "https://github.com/limeskat"
  },
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "minecraft",
    "players",
    "whitelist",
    "operators",
    "bans",
    "inventory",
    "nbt",
    "teleport",
    "statistics",
    "purge"
  ],
  "engines": {
    "kubek": ">=4.0.0"
  },
  "permissions": {
    "declares": [
      {
        "key": "ext.players.view",
        "label": "View players, access lists, and statistics",
        "group": "Players Management"
      },
      {
        "key": "ext.players.control",
        "label": "Execute player actions (kick, heal, feed, kill, starve, gamemode, teleport)",
        "group": "Players Management"
      },
      {
        "key": "ext.players.manage_access",
        "label": "Modify access lists (Whitelist, OPs, Banned Players, Banned IPs)",
        "group": "Players Management"
      },
      {
        "key": "ext.players.purge",
        "label": "Purge and reset player data files (NBT, stats, advancements)",
        "group": "Players Management"
      }
    ],
    "requires": [
      "servers:read",
      "servers:control",
      "http:routes",
      "http:outbound",
      "settings",
      "events:server",
      "events:players",
      "events:logs"
    ]
  },
  "backend": {
    "entry": "backend/index.ts",
    "isolation": "in-process",
    "events": [
      "server.started",
      "server.stopped",
      "server.crashed",
      "player.joined",
      "player.left",
      "server.log"
    ]
  },
  "frontend": {
    "entry": "frontend/src/index.ts",
    "contributes": {
      "sidebar": [
        {
          "id": "players-tab",
          "label": "Players",
          "icon": "Users",
          "route": "io.github.limeskat.players/PlayersDashboard",
          "permission": "ext.players.view",
          "section": "server"
        }
      ]
    }
  },
  "settingsSchema": [
    {
      "key": "avatarProvider",
      "type": "select",
      "label": "Player Avatar Provider",
      "options": [
        "crafatar",
        "minotar",
        "mc-heads",
        "visage"
      ],
      "default": "mc-heads"
    }
  ],
  "homepage": "https://github.com/limeskat/kubek-extension-players"
}
